# Required: Primary AI Provider
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EXPLAIN_MODEL=gemini-3.8-flash

# Optional: LLM Timeout (in seconds, default: 60)
LLM_TIMEOUT_SECONDS=60
# Maximum concurrent lesson-generation jobs (default: 2)
MAX_ACTIVE_LESSON_JOBS=2

# Optional: Fallback AI Provider
# If omitted, Gemini remains the only AI provider.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: Set this to any model ID currently available through Groq.
# If omitted, the application uses its configured fallback.
GROQ_EXPLAIN_MODEL=

# Optional: Cloudinary Storage
# If omitted or incomplete, videos remain in local storage.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# D-ID AI Avatar
DID_API_KEY=your_did_api_key
DID_API_URL=https://api.d-id.com
DID_SOURCE_URL=your_public_avatar_image_url


# Internal authentication key for requests from the Node.js backend
AI_SERVICE_KEY=your_internal_ai_service_key

# Optional: RAG settings
# Set to true to enable RAG retrieval
RAG_ENABLED=false
RAG_EMBEDDING_MODEL=text-embedding-004
RAG_EMBEDDING_DIMENSIONS=768
RAG_EMBEDDING_BATCH_SIZE=32
RAG_TOP_K=4
RAG_MAX_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_MAX_CONTEXT_SIZE=4000
# 10 MB maximum upload size in bytes
RAG_MAX_UPLOAD_BYTES=10485760
