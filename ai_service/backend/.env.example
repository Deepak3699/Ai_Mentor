# Required: Primary AI Provider
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional: Fallback AI Provider
# If omitted, Gemini remains the only AI provider.
GROQ_API_KEY=your_groq_api_key

# Optional: Cloudinary Storage
# If omitted or incomplete, videos remain in local storage.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# D-ID AI Avatar
DID_API_KEY=your_did_api_key
DID_API_URL=https://api.d-id.com
DID_SOURCE_URL=your_public_avatar_image_url

# AI-content safety settings (added for issue #265)
#
# REQUIRE_SCRIPT_MODERATION — set to "true" to make content moderation
# mandatory.  When True an unexpected error in the moderation step will cause
# the job to fail rather than continue.  Defaults to false so the service
# works in development environments without an external moderation provider.
REQUIRE_SCRIPT_MODERATION=false
#
# FALLBACK_CELEBRITY_SOURCE — the local video source used when the requested
# celebrity asset is not found on disk.  Defaults to "owl" (an animated
# character) so that unverified real-person footage is never silently selected.
# Operators may change this to any value listed in ALLOWED_CELEBRITIES once
# they have confirmed the necessary redistribution rights.
FALLBACK_CELEBRITY_SOURCE=owl
